[gd_resource type="Theme" format=3]

[ext_resource type="FontFile" path="res://assets/fonts/Nunito.ttf" id="1_nunito"]
[ext_resource type="FontFile" path="res://assets/fonts/Baloo2.ttf" id="2_baloo"]
[ext_resource type="FontFile" path="res://assets/fonts/NotoSansArabic.ttf" id="3_noto"]

[sub_resource type="FontVariation" id="FontVariation_body"]
fallbacks = Array[Font]([ExtResource("3_noto")])
base_font = ExtResource("1_nunito")
variation_opentype = {2003265652: 650}

[sub_resource type="FontVariation" id="FontVariation_title"]
